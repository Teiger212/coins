# Bridge port
PORT=3001

# LearnHouse API
LH_BASE_URL=https://lms.lanternroute.com
LH_ORG_SLUG=default
# Surfaced in magic-link and refund email copy.
LH_BRAND_NAME=חופשי

# Admin API token. Mint at:
#   POST /api/v1/orgs/{org_id}/api-tokens
# Required rights: users.{create,read,update}, courses.read, enrollments.{create,delete}.
# (See apps/api/src/db/roles.py for the rights schema.)
LH_ADMIN_TOKEN=

# Grow webhook signing secret. Set in Grow's webhook config and copy here.
# Used to verify the X-Grow-Signature header on /webhooks/grow.
# Format / header name TBD — confirm with Grow docs / a real test webhook.
GROW_WEBHOOK_SECRET=

# Access window (days) for every paid enrollment. Reaper script unenrolls past this.
ENROLLMENT_TTL_DAYS=365

# SQLite DB path — idempotency store + enrollment window tracking.
# Mount a volume here when running in Docker: ./data/bridge:/var/lib/bridge
SQLITE_PATH=/var/lib/bridge/bridge.db

# Resend (email) — BLOCKED on operator getting a verified sending domain.
# Until then the bridge logs the magic-link URL instead of sending email.
RESEND_API_KEY=
RESEND_FROM=

# Mailchimp — optional; if unset, buyer tagging is a no-op.
# API key format: "xxx-usYY" where "usYY" is the server prefix (parsed automatically).
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# LH → Webflow course sync (Phase 5). Optional unless /webhooks/lh-course is used.
LH_COURSE_WEBHOOK_SECRET=
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COURSES_COLLECTION_ID=
